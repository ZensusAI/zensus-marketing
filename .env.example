# Environment variables for the Zensus marketing site.
#
# VITE_* are inlined into the client bundle at BUILD time, so changing one on
# Vercel requires a redeploy before it takes effect. Everything else is read at
# request time by the serverless functions under api/.

# --- Client (build time) ---------------------------------------------------

# PostHog. Analytics stay opted out until the visitor consents; see
# src/lib/consent.ts. When the key is absent, posthog-js is never loaded.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile site key (public half). When absent, the support form
# and the calculator email capture refuse to submit rather than failing open.
# Add the site's hostname to the widget's allowed hostnames in Cloudflare.
VITE_TURNSTILE_SITE_KEY=

# --- Server (request time, api/) -------------------------------------------

# Turnstile secret half, used to verify tokens server-side.
TURNSTILE_SECRET_KEY=

# Amazon SES, used to deliver calculator breakdowns and support acknowledgements.
# The From address intentionally stays on zensus.app; see docs on the domain move.
SES_FROM=hello@zensus.app
SES_REGION=us-east-1
ACK_AWS_ACCESS_KEY_ID=
ACK_AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock, used to draft support acknowledgement replies.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_TIMEOUT_MS=

# Lead forwarding endpoint for the calculator tools. Optional; falls back to a
# built-in default when unset.
TOOL_LEAD_FORMINIT_URL=

# Set either to 1 to log instead of sending, for local testing.
ACK_DRY_RUN=
TOOL_DRY_RUN=

# --- Build / CI ------------------------------------------------------------

# IndexNow key (32 hex). Falls back to the single public/<key>.txt proof file
# when unset. Pings are gated on VERCEL=1 + VERCEL_ENV=production.
INDEXNOW_KEY=
